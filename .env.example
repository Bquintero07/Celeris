# ---- Supabase (own project, NOT Lovable) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Prisma uses the Supabase pooler (transaction mode, port 6543) for serverless:
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) only for migrations:
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---- AI agent ----
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=
# Shared secret the Node API sends to the Python agent — only the API may call paid/AI endpoints:
AGENT_SHARED_SECRET=

# ---- API server ----
# Comma-separated list of allowed frontend origins:
CORS_ORIGIN=http://localhost:5173

# ---- Web (Vite, must be prefixed with VITE_) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
